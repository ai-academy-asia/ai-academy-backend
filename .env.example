# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=aiaa
POSTGRES_PASSWORD=aiaa_dev_password
POSTGRES_DB=aiaa
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full SQLAlchemy URL (optional; built from the parts above if omitted)
# DATABASE_URL=postgresql+psycopg2://aiaa:aiaa_dev_password@localhost:5433/aiaa

# ===== eBarimt / PosAPI =====
# PosAPI is a daemon you run yourself; it is not a compose service.
#
# Running the app straight on the host (python wsgi.py):
#     EBARIMT_POSAPI_URL=http://localhost:7080
# Running it under docker compose (`app` / `ebarimt-sender` containers):
#     EBARIMT_POSAPI_URL=http://host.docker.internal:7080
# `localhost` inside a container is the container itself, so the host value
# there fails every hourly flush with posapi_unreachable — and the only sign is
# a line in the sender's log.
EBARIMT_POSAPI_URL=http://localhost:7080

# true = issue placeholder receipts locally, ask PosAPI for nothing. Nothing is
# transmitted to the tax authority while this is on.
EBARIMT_TEMP_MODE=true
EBARIMT_AUTO_ISSUE=true

# How often ebarimt-sender flushes to the tax authority. 3600 = hourly, aligned
# to the hour rather than to container start.
EBARIMT_SEND_INTERVAL_SECONDS=3600

# From PosAPI's /rest/info once the merchant is registered.
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=
EBARIMT_DISTRICT_CODE=
EBARIMT_BRANCH_NO=001
