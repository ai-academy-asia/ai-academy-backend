# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=aiaa
POSTGRES_PASSWORD=aiaa_dev_password
POSTGRES_DB=aiaa
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full SQLAlchemy URL (optional; built from the parts above if omitted)
# DATABASE_URL=postgresql+psycopg2://aiaa:aiaa_dev_password@localhost:5433/aiaa

# Production only. RDS rotates the master password every 7 days, which strands
# any password written into DATABASE_URL. Point this at the Secrets Manager
# secret holding it and the URL's password becomes a fallback: the live one is
# read per connection via the EC2 instance role. Leave unset locally.
# DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<account>:secret:rds!db-xxxxxxxx
# DB_SECRET_TTL=900

# ===== eBarimt / PosAPI =====
# PosAPI is a daemon you run yourself; it is not a compose service.
#
# Running the app straight on the host (python wsgi.py):
#     EBARIMT_POSAPI_URL=http://localhost:7080
# Running it under docker compose (`app` / `ebarimt-sender` containers):
#     EBARIMT_POSAPI_URL=http://host.docker.internal:7080
# `localhost` inside a container is the container itself, so the host value
# there fails every hourly flush with posapi_unreachable — and the only sign is
# a line in the sender's log.
EBARIMT_POSAPI_URL=http://localhost:7080

# true = issue placeholder receipts locally, ask PosAPI for nothing. Nothing is
# transmitted to the tax authority while this is on.
EBARIMT_TEMP_MODE=true
EBARIMT_AUTO_ISSUE=true

# How often ebarimt-sender flushes to the tax authority. 3600 = hourly, aligned
# to the hour rather than to container start.
EBARIMT_SEND_INTERVAL_SECONDS=3600

# From PosAPI's /rest/info once the merchant is registered.
EBARIMT_MERCHANT_TIN=
EBARIMT_POS_NO=
EBARIMT_DISTRICT_CODE=
EBARIMT_BRANCH_NO=001

# ===== Push notifications (Firebase Cloud Messaging, issue #2) =====
# Unset by default: notifications stay in-app only and nothing is pushed.
# To enable, set FCM_CREDENTIALS to a Firebase service-account key from the
# SAME Firebase project as the mobile app's google-services.json:
#   - production host's .env: the key's JSON serialized as ONE line (e.g.
#     `jq -c . key.json`), in single quotes. A .env value cannot span lines,
#     and the app container mounts no files, so a path would not exist there.
#   - local runs: a path to the key file, kept under the git-ignored .secrets/.
# Never commit a real key. The line below is a placeholder, not a credential.
# FCM_CREDENTIALS='{"type":"service_account","project_id":"<firebase-project-id>","client_email":"<name>@<firebase-project-id>.iam.gserviceaccount.com","private_key":"<PEM key, newlines written as \n>"}'
# FCM_HTTP_TIMEOUT=10
